# Meta 광고 MCP. 개발자 화면의 MCP로 연결하는 공식 광고 서버입니다.
# 앱 사용 사례에 "Create & manage ads with ads MCP server"를 추가하세요.
# 토큰 권한: ads_mcp_management, ads_management. 시스템 사용자는 직원 역할만 됩니다.
META_TRANSPORT=mcp
META_MCP_URL=https://mcp.facebook.com/ads
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=act_1234567890
META_PAGE_ID=
META_BUSINESS_ID=
META_API_VERSION=v25.0
# 그래프 API를 직접 쓰려면 META_TRANSPORT=graph

# 시트에 실험 ID를 남기려면 비즈니스 ID와 함께 true로 두세요.
# 비즈니스 ID가 있으면 기본값은 true 입니다. 끄려면 false.
CREATE_SPLIT_TEST=

# Google
# 서비스 계정 JSON을 쓰고, 시트와 소재 폴더를 그 계정 이메일에 공유하세요.
GOOGLE_SERVICE_ACCOUNT_FILE=service-account.json
# 내 드라이브에 직접 접근하려면 OAuth를 사용합니다. `ab-test auth-google`로 token.json을 만듭니다.
GOOGLE_OAUTH_CLIENT_SECRETS=
GOOGLE_OAUTH_TOKEN_FILE=token.json

# 구글 스프레드시트. URL의 /d/ 와 /edit 사이에 있는 ID입니다.
GOOGLE_SHEET_ID=1PFIwGauupRfcq01oHyG8kmiK86Q3PNfYthEB9E2ki-4
GOOGLE_SHEET_RANGE=

# 소재(이미지, 동영상)가 들어 있는 드라이브 폴더 ID
GOOGLE_DRIVE_FOLDER_ID=

# 로컬 파일로 시험할 때. 구글 시트 ID가 있으면 시트가 우선합니다.
SHEET_PATH=examples/ads_template.csv
CREATIVES_DIR=examples/creatives

# Asia/Seoul 기준 날짜를 Meta에 전달합니다.
TIMEZONE=Asia/Seoul
